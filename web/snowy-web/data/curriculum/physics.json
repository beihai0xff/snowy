{
  "version": "pep-2019",
  "subject": "physics",
  "books": [
    {
      "version": "pep-2019",
      "subject": "physics",
      "book": "compulsory-1",
      "book_title": "普通高中教科书·物理·必修第一册",
      "chapters": [
        {
          "id": "ch1",
          "title": "运动的描述",
          "sections": [
            {
              "id": "ch1.1",
              "title": "质点 参考系",
              "knowledge_tags": [
                "particle_model",
                "reference_frame",
                "1d_kinematics_simulation"
              ],
              "learning_goals": [
                "知道质点是理想化模型",
                "知道运动的相对性，能选择合适的参考系"
              ],
              "difficulty": "easy"
            },
            {
              "id": "ch1.2",
              "title": "时间 位移",
              "knowledge_tags": [
                "displacement_vs_distance",
                "time_interval"
              ],
              "learning_goals": [
                "区分位移与路程",
                "知道矢量与标量"
              ],
              "core_formulas": [
                "\\\\vec{s} = \\\\vec{r_2} - \\\\vec{r_1}"
              ],
              "difficulty": "easy"
            },
            {
              "id": "ch1.3",
              "title": "位置变化快慢的描述——速度",
              "knowledge_tags": [
                "velocity",
                "average_velocity",
                "instantaneous_velocity",
                "1d_kinematics_simulation",
                "uniform_motion"
              ],
              "learning_goals": [
                "理解速度的概念，区分平均速度与瞬时速度",
                "会用 v = Δx/Δt 计算"
              ],
              "core_formulas": [
                "v = \\\\dfrac{\\\\Delta x}{\\\\Delta t}"
              ],
              "difficulty": "medium"
            },
            {
              "id": "ch1.4",
              "title": "速度变化快慢的描述——加速度",
              "knowledge_tags": [
                "acceleration",
                "kinematics"
              ],
              "learning_goals": [
                "理解加速度的方向与速度方向的关系"
              ],
              "core_formulas": [
                "a = \\\\dfrac{\\\\Delta v}{\\\\Delta t}"
              ],
              "difficulty": "medium"
            }
          ]
        },
        {
          "id": "ch2",
          "title": "匀变速直线运动的研究",
          "sections": [
            {
              "id": "ch2.2",
              "title": "匀变速直线运动的速度与时间的关系",
              "knowledge_tags": [
                "uniform_accelerated_motion",
                "kinematics"
              ],
              "learning_goals": [
                "推导并应用 v = v₀ + at"
              ],
              "core_formulas": [
                "v = v_0 + at"
              ],
              "difficulty": "medium"
            },
            {
              "id": "ch2.3",
              "title": "位移与时间的关系",
              "knowledge_tags": [
                "uniform_accelerated_motion",
                "displacement_time",
                "kinematics"
              ],
              "learning_goals": [
                "推导并应用 x = v₀t + ½at²",
                "理解 v-t 图像与位移的关系"
              ],
              "core_formulas": [
                "x = v_0 t + \\\\tfrac{1}{2} a t^2",
                "v^2 = v_0^2 + 2 a x"
              ],
              "difficulty": "medium"
            },
            {
              "id": "ch2.4",
              "title": "自由落体运动",
              "knowledge_tags": [
                "free_fall",
                "gravity",
                "vertical_freefall"
              ],
              "learning_goals": [
                "认识自由落体是初速度为 0 的匀加速运动"
              ],
              "core_formulas": [
                "h = \\\\tfrac{1}{2} g t^2",
                "v = g t"
              ],
              "difficulty": "medium"
            }
          ]
        },
        {
          "id": "ch3",
          "title": "相互作用——力",
          "sections": [
            {
              "id": "ch3.1",
              "title": "重力与弹力",
              "knowledge_tags": [
                "gravity_force",
                "spring_force",
                "hooke_law"
              ],
              "learning_goals": [
                "理解胡克定律"
              ],
              "core_formulas": [
                "F = k x"
              ],
              "difficulty": "easy"
            },
            {
              "id": "ch3.2",
              "title": "摩擦力",
              "knowledge_tags": [
                "friction",
                "static_friction",
                "kinetic_friction"
              ],
              "difficulty": "medium"
            },
            {
              "id": "ch3.4",
              "title": "力的合成与分解",
              "knowledge_tags": [
                "force_decomposition",
                "parallelogram_law",
                "vector_addition"
              ],
              "difficulty": "medium"
            }
          ]
        },
        {
          "id": "ch4",
          "title": "运动和力的关系",
          "sections": [
            {
              "id": "ch4.2",
              "title": "实验：探究加速度与力、质量的关系",
              "knowledge_tags": [
                "newton_second_law_experiment"
              ],
              "difficulty": "medium"
            },
            {
              "id": "ch4.3",
              "title": "牛顿第二定律",
              "knowledge_tags": [
                "newton_second_law",
                "force_acceleration_mass"
              ],
              "learning_goals": [
                "理解 F = ma 中三个量的方向关系",
                "能用 F = ma 解决斜面、连接体等问题"
              ],
              "core_formulas": [
                "F = m a"
              ],
              "difficulty": "hard"
            }
          ]
        }
      ]
    },
    {
      "version": "pep-2019",
      "subject": "physics",
      "book": "compulsory-2",
      "book_title": "普通高中教科书·物理·必修第二册",
      "chapters": [
        {
          "id": "ch5",
          "title": "抛体运动",
          "sections": [
            {
              "id": "ch5.1",
              "title": "曲线运动",
              "knowledge_tags": [
                "curved_motion",
                "velocity_direction"
              ],
              "learning_goals": [
                "知道曲线运动的速度方向沿轨迹的切线方向",
                "知道曲线运动是变速运动"
              ],
              "difficulty": "medium"
            },
            {
              "id": "ch5.2",
              "title": "运动的合成与分解",
              "knowledge_tags": [
                "motion_decomposition",
                "vector_addition"
              ],
              "learning_goals": [
                "理解小船渡河、绳模型分速度的处理方法"
              ],
              "difficulty": "medium"
            },
            {
              "id": "ch5.4",
              "title": "抛体运动的规律",
              "knowledge_tags": [
                "projectile_motion",
                "horizontal_uniform",
                "vertical_freefall"
              ],
              "learning_goals": [
                "理解平抛运动可分解为水平匀速 + 竖直自由落体",
                "推导并应用 x = v₀t、y = ½gt²",
                "计算落地速度大小与方向"
              ],
              "core_formulas": [
                "x = v_0 t",
                "y = \\\\tfrac{1}{2} g t^2",
                "v_y = g t",
                "v = \\\\sqrt{v_x^2 + v_y^2}"
              ],
              "difficulty": "hard"
            }
          ]
        },
        {
          "id": "ch6",
          "title": "圆周运动",
          "sections": [
            {
              "id": "ch6.1",
              "title": "圆周运动",
              "knowledge_tags": [
                "circular_motion",
                "angular_velocity",
                "linear_velocity"
              ],
              "core_formulas": [
                "v = \\\\omega r",
                "T = \\\\dfrac{2\\\\pi}{\\\\omega}"
              ],
              "difficulty": "medium"
            },
            {
              "id": "ch6.2",
              "title": "向心力",
              "knowledge_tags": [
                "centripetal_force",
                "centripetal_acceleration"
              ],
              "core_formulas": [
                "F = \\\\dfrac{m v^2}{r} = m \\\\omega^2 r"
              ],
              "difficulty": "hard"
            }
          ]
        },
        {
          "id": "ch7",
          "title": "万有引力与宇宙航行",
          "sections": [
            {
              "id": "ch7.2",
              "title": "万有引力定律",
              "knowledge_tags": [
                "gravitation",
                "kepler_law",
                "orbital_motion"
              ],
              "core_formulas": [
                "F = G \\\\dfrac{m_1 m_2}{r^2}"
              ],
              "difficulty": "medium"
            },
            {
              "id": "ch7.3",
              "title": "万有引力理论的成就",
              "knowledge_tags": [
                "orbital_motion",
                "satellite",
                "kepler_law"
              ],
              "learning_goals": [
                "由 GMm/r² = mv²/r 推出第一宇宙速度"
              ],
              "core_formulas": [
                "v = \\\\sqrt{\\\\dfrac{GM}{r}}",
                "T = 2\\\\pi \\\\sqrt{\\\\dfrac{r^3}{GM}}"
              ],
              "difficulty": "hard"
            }
          ]
        },
        {
          "id": "ch8",
          "title": "机械能守恒定律",
          "sections": [
            {
              "id": "ch8.1",
              "title": "功与功率",
              "knowledge_tags": [
                "work",
                "power"
              ],
              "core_formulas": [
                "W = F s \\\\cos\\\\theta",
                "P = \\\\dfrac{W}{t} = F v"
              ],
              "difficulty": "medium"
            },
            {
              "id": "ch8.2",
              "title": "重力势能",
              "knowledge_tags": [
                "gravitational_pe"
              ],
              "core_formulas": [
                "E_p = m g h"
              ],
              "difficulty": "easy"
            },
            {
              "id": "ch8.3",
              "title": "动能和动能定理",
              "knowledge_tags": [
                "kinetic_energy",
                "work_energy_theorem"
              ],
              "core_formulas": [
                "E_k = \\\\tfrac{1}{2} m v^2",
                "W_{\\\\text{合}} = \\\\Delta E_k"
              ],
              "difficulty": "hard"
            },
            {
              "id": "ch8.4",
              "title": "机械能守恒定律",
              "knowledge_tags": [
                "mechanical_energy_conservation",
                "spring_oscillation",
                "simple_harmonic"
              ],
              "learning_goals": [
                "应用机械能守恒处理单摆、弹簧、斜面问题"
              ],
              "core_formulas": [
                "E_k + E_p = \\\\text{const}"
              ],
              "difficulty": "hard"
            }
          ]
        }
      ]
    }
  ],
